{
  "name": "obsidian-goodcharts",
  "version": "0.1.0",
  "packageManager": "bun@1.3.8",
  "private": true,
  "license": "MIT",
  "description": "Render simple, theme-aware charts in Obsidian using TanStack Charts",
  "scripts": {
    "build": "bun run esbuild.config.mjs",
    "deploy": "bun run esbuild.config.mjs --deploy",
    "lint": "eslint .",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "verify": "bun test && bun run typecheck && bun run lint && bun run build"
  },
  "dependencies": {
    "@tanstack/charts": "0.14.0",
    "@tanstack/preact-charts": "0.14.0",
    "d3-color": "3.1.0",
    "d3-scale": "4.0.2",
    "d3-shape": "3.2.0",
    "d3-time-format": "4.1.0",
    "preact": "10.27.2",
    "yaml": "2.8.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@types/bun": "1.3.8",
    "@types/d3-scale": "4.0.9",
    "@types/d3-shape": "3.1.7",
    "@types/node": "^22.15.17",
    "esbuild": "0.25.9",
    "eslint": "^9.39.4",
    "eslint-plugin-obsidianmd": "^0.4.0",
    "globals": "^17.6.0",
    "jiti": "^2.6.1",
    "obsidian": "1.8.7",
    "typescript": "5.9.2",
    "typescript-eslint": "^8.59.1"
  }
}
