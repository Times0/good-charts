{
  "name": "goodcharts",
  "version": "0.4.0",
  "packageManager": "bun@1.4.4",
  "private": true,
  "license": "MIT",
  "description": "Create powerful, composable charts, powered by TanStack Charts",
  "scripts": {
    "build": "bun run esbuild.config.mjs",
    "deploy": "bun run esbuild.config.mjs --deploy",
    "lint": "eslint .",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "verify": "bun test && bun run typecheck && bun run lint && bun run build"
  },
  "dependencies": {
    "@tanstack/charts": "1.1.0",
    "d3-shape": "3.2.0",
    "preact": "11.1.0",
    "yaml": "2.9.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/bun": "1.4.4",
    "@types/d3-shape": "3.2.0",
    "@types/node": "^26.6.5",
    "esbuild": "0.28.2",
    "eslint": "^10.13.0",
    "eslint-plugin-obsidianmd": "^0.4.2",
    "globals": "^17.13.0",
    "jiti": "^2.7.0",
    "obsidian": "1.14.4",
    "typescript": "6.0.3",
    "typescript-eslint": "^8.72.1"
  }
}
